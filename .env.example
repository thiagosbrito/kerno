# Names only. Copy to .env.local per app and fill in locally; never commit values.
# Public (browser-safe) variables must use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_ADMIN_URL=
NEXT_PUBLIC_STOREFRONT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Must never be exposed to a client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Storefront host routing (docs/security/host-routing.md). PLATFORM_DOMAIN is the suffix for <slug>.<domain> store hosts.
PLATFORM_DOMAIN=
# Optional. Name of the ONE header your trusted edge sets with the public hostname (for example x-forwarded-host).
# Leave empty unless the edge overwrites it on every request; empty means only the Host header is used.
TRUSTED_FORWARDED_HOST_HEADER=
