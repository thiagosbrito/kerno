{
  "name": "kerno",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint e2e playwright.config.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "docs:check": "python3 scripts/validate_docs.py",
    "test:bundles": "env NEXT_PUBLIC_ADMIN_URL=http://localhost:3000 NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001 NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321 NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-sentinel PLATFORM_DOMAIN=localhost SUPABASE_SERVICE_ROLE_KEY=SERVICE-ROLE-SENTINEL-9f3a sh -c 'turbo run build --force && python3 scripts/check_bundles.py'",
    "test:bundles:self": "python3 scripts/test_check_bundles.py",
    "scan:secrets": "python3 scripts/scan_secrets.py",
    "test:secrets:self": "python3 scripts/test_scan_secrets.py",
    "test:workflows:self": "python3 scripts/test_check_workflows.py",
    "check:workflows": "python3 scripts/check_workflows.py",
    "audit:deps": "pnpm audit --audit-level=high",
    "setup:env": "python3 scripts/setup_env.py",
    "db:start": "supabase start -x edge-runtime,logflare,vector,imgproxy,mailpit",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "test:db": "env KERNO_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres pnpm --filter @kerno/supabase test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "supabase": "2.122.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
